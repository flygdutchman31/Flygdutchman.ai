{
  "name": "flygdutchman-contracts",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "export-abi": "hardhat build && node scripts/export-abi.mjs",
    "node": "hardhat node",
    "deploy:local": "hardhat ignition deploy ignition/modules/TestnetBoard.ts --network localhost",
    "deploy:testnet": "hardhat ignition deploy ignition/modules/TestnetBoard.ts --network bscTestnet --verify",
    "deploy:mainnet": "hardhat ignition deploy ignition/modules/AgentBountyBoard.ts --network bsc --verify"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.10",
    "@nomicfoundation/hardhat-ignition-viem": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.2",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.2",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@nomicfoundation/hardhat-verify": "^3.1.5",
    "@nomicfoundation/hardhat-viem": "^3.1.0",
    "@nomicfoundation/hardhat-viem-assertions": "^3.1.5",
    "@nomicfoundation/ignition-core": "^3.1.11",
    "@types/node": "^26.6.7",
    "hardhat": "^3.22.0",
    "typescript": "^7.0.2",
    "viem": "^2.58.6"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
